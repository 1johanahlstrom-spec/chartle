# Tailscale Funnel ansluter från 127.0.0.1 och skickar klientens adress i
# X-Forwarded-For. trusted_proxies låter {client_ip} plocka fram den riktiga
# klienten i stället för Funnels/Dockerns adress — annars hamnar alla spelare
# i samma rate-limit-hink. 100.64.0.0/10 täcker Tailscales CGNAT-adresser.
{
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080 {
			# Utan detta ser API:t bara Caddys container-IP, och rate
			# limitingen skulle råka gälla alla spelare gemensamt. {client_ip}
			# respekterar trusted_proxies ovan och följer X-Forwarded-For.
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv
		file_server
	}

	# Pusselfilerna är oföränderliga under sin versions-URL (se
	# PUZZLE_VERSION i docs/game.js och repair_splits.py) och kan därför
	# cachas hårt — det gör spelet märkbart snabbare.
	@puzzles path /puzzles/*
	header @puzzles Cache-Control "public, max-age=31536000, immutable"

	# Plotly är versionsstämplat i filnamnet.
	@vendor path /vendor/*
	header @vendor Cache-Control "public, max-age=31536000, immutable"

	# Egen kod revalideras alltid, så en deploy slår igenom direkt även om
	# någon missar att bumpa ?v= i index.html. Undantaget är vendor/ ovan:
	# annars skriver den senare regeln över den hårda cachen för Plotly.
	@code {
		not path /vendor/*
		path *.js *.css /
	}
	header @code Cache-Control "no-cache"

	# Manifestet ska, liksom service workern ovan, upptäcka nya deployer snabbt.
	@manifest path /manifest.webmanifest
	header @manifest Cache-Control "no-cache"

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# 'unsafe-inline' i style-src krävs av Plotly, som injicerar en
		# <style>-tagg vid uppstart. Script- och connect-src är låsta till
		# egen origin — inga externa beroenden finns kvar.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
	}
}
